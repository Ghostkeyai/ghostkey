# GHOSTKEY — salin ke .env lalu isi. JANGAN commit (.env ada di .gitignore).
# Komentar setelah spasi + '#' diabaikan oleh server/config.mjs.

PORT=4877
PUBLIC_URL=https://ghostkeyai.com
# GHOSTKEY_DATA_DIR=/var/lib/ghostkey   # DB + data/ledger/hour-<n>.json (bawaan: ./data)

# OpenRouter: satu kunci bersama milik GHOSTKEY (pasang batas "Key limit" di openrouter.ai/settings/keys).
# Kosong = MODE TIRUAN (jawaban palsu berlabel "mock"), untuk uji lokal.
OPENROUTER_API_KEY=

# Dompet & kontrak (Robinhood Chain 4663). Kosong = situs menampilkan "Not deployed yet" / "Launches soon".
TREASURY_ADDRESS=            # tujuan top-up + pool Ghost Credit (25%) — dibuat tools/new-wallets.mjs
OWNER_WALLET=                # 75% fee $GHOST (dompet milik pemilik sendiri)
GHOST_MNEMONIC=              # HD: m/44'/60'/0'/0/0 = dompet fee $GHOST, m/44'/60'/1'/0/0 = gas + poster ledger — dibuat tools/new-wallets.mjs
GHOST_TOKEN=                 # CA $GHOST setelah launch
GHOST_TOKEN_BLOCK=           # opsional: blok deploy $GHOST (mempercepat pencarian pemegang)
LEDGER_ADDRESS=              # alamat GhostLedger setelah deploy (tools/deploy-ledger.sh)
TEAM_WALLETS=                # dipisah koma; dikecualikan dari Ghost Credit, tampil di /proof
FEE_WALLET=                  # opsional: alamat dompet fee untuk /proof bila mnemonic tidak dipasang di server ini

# Ghost Credit
HOLDER_MIN_TOKENS=100000     # minimal rata-rata saldo $GHOST agar dapat bagian
HOLDER_SHARE_BPS=2500        # 25% fee untuk pemegang
HARVEST_MINUTE=50            # panen fee tiap jam di menit ini (UTC)
CREDIT_MINUTE=5              # proses jam sebelumnya di menit ini (UTC)
HARVEST_MIN_WEI=2000000000000000   # minimal 0,002 ETH di FeeEscrow sebelum diklaim

# Pesan gratis
FREE_MESSAGES=10             # per browser, tanpa dompet
FREE_API_CALLS=10            # per akun baru lewat /v1
FREE_PER_IP_DAY=30           # IP tidak disimpan: dihitung dengan hash bergaram di memori
FREE_DAILY_USD=2             # pagu biaya gratis seluruh situs per hari
FREE_MAX_OUT_PER_M=1         # model gratis: output ≤ $1 per 1 juta token (harga ZDR termahal)
FREE_MAX_TOKENS=1200

# Isi saldo (tanpa biaya)
MIN_DEPOSIT_USD=5
MAX_DEPOSIT_USD=2000
MIN_CONFIRMATIONS=3

# RPC (opsional; bawaan: daftar titik publik berotasi di server/chain/config.mjs)
# RPC_URLS=https://robinhood-rpc.publicnode.com,https://rpc.mainnet.chain.robinhood.com
# LOGS_RPC_URLS=https://robinhood.api.pocket.network,https://robinhood.drpc.org

# Lain-lain
ADMIN_KEY=                   # kunci acak untuk /api/admin/*
COOKIE_SECURE=1              # 1 di produksi (HTTPS)
LINK_X=https://x.com/ghostkeyai
LINK_TELEGRAM=
LINK_GITHUB=                 # dipakai untuk tautan kode (privacy.mjs, db.mjs, dll) di /proof & inspector
